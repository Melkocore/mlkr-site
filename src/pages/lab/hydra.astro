---
import BaseLayout from '../../layouts/BaseLayout.astro';
import HydraEmbed from '../../components/HydraEmbed.astro';
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const example = `osc(4, 0.1, 1.2).diff(noise(3)).color(0.2, 0.9, 0.3).out()`;
---
<BaseLayout title="Lab — Hydra — M3LK0K093">
  <section class="container py-12">
    <p class="font-mono text-acid text-sm mb-2"><a href={`${base}lab`}>← lab</a></p>
    <h1 class="font-mono text-acid text-2xl mb-4">## hydra</h1>
    <p class="text-fg-muted text-sm mb-6">Visuales procedurales. Edita el código y ejecútalo.</p>
    <HydraEmbed title="Experimento 01" code={example} />
  </section>
</BaseLayout>