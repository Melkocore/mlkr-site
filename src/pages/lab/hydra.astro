---
import BaseLayout from '../../layouts/BaseLayout.astro';
import StrudelLab from '../../components/StrudelLab.astro';
const hydraCode = `// ===== VISUAL =====
await initHydra({ feedStrudel: true })
osc(4, 0.08, 1.2).color(0.1, 0.9, 0.2).modulate(noise(3, 0.1), 0.2).rotate(0.06, 0.01).posterize(8).out()

// ===== AUDIO =====
setcpm(80/4)
$: sound("cp").struct("~ x*4 ~.4 x*4?").distort(0.6).room(0.4).gain(0.2)
`;
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
---
<BaseLayout title="Lab — Hydra — M3LK0K093">
  <section class="container py-12">
    <p class="font-mono text-acid text-sm mb-2"><a href={`${base}lab`}>← lab</a></p>
    <h1 class="font-mono text-acid text-2xl mb-4">## hydra</h1>
    <StrudelLab code={hydraCode} title="Hydra direct" />
  </section>
</BaseLayout>