---
import BaseLayout from '../../layouts/BaseLayout.astro';
import StrudelEmbed from '../../components/StrudelEmbed.astro';
import { getCollection } from 'astro:content';

const tracks = (await getCollection('tracks')).sort((a,b) => a.data.index - b.data.index);
const first = tracks[0];
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
---
<BaseLayout title="Lab — Strudel — M3LK0K093">
  <section class="container py-12">
    <p class="font-mono text-acid text-sm mb-2"><a href={`${base}lab`}>← lab</a></p>
    <h1 class="font-mono text-acid text-2xl mb-4">## strudel</h1>
    {first?.data.script && (
      <StrudelEmbed title={`Script: ${first.data.title}`} code={first.data.script} />
    )}
    <section class="mt-8">
      <h2 class="font-mono text-acid mb-3">## scripts disponibles</h2>
      <ul class="space-y-2">
        {tracks.map((t) => (
          <li class="font-mono text-sm"><a href={`${base}musica/${t.data.album}`} class="hover:text-acid">{t.data.title}</a> · {t.data.tags.join(', ')}</li>
        ))}
      </ul>
    </section>
  </section>
</BaseLayout>