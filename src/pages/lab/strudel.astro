---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import StrudelLab from '../../components/StrudelLab.astro';
const tracks = (await getCollection('tracks')).sort((a,b)=>a.data.index-b.data.index);
const first = tracks[0];
const labCode = first?.data.script ?? '';
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
---
<BaseLayout title="Lab — Strudel — M3LK0K093">
  <section class="container py-12">
    <p class="font-mono text-acid text-sm mb-2"><a href={`${base}lab`}>← lab</a></p>
    <h1 class="font-mono text-acid text-2xl mb-4">## strudel</h1>
    {first && <StrudelLab code={labCode} title={`Strudel: ${first.data.title}`} />}
  </section>
</BaseLayout>