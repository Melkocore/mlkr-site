---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import StrudelLab from '../../components/StrudelLab.astro';

const tracks = (await getCollection('tracks')).sort((a, b) => a.data.index - b.data.index);
const first = tracks[0];
const labCode = first?.data.script ?? '';
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
---
<BaseLayout title="Lab — M3LK0K093" description="Live-coding directo con Strudel y Hydra.">
  <section class="container py-12">
    <h1 class="font-mono text-acid text-2xl mb-2">## lab</h1>
    <p class="text-fg-muted mb-6 text-sm">
      Strudel + Hydra embebidos. Editá el código, pulsá <span class="text-acid">Reproducir</span> o Ctrl+Enter.
      El bloque <span class="text-acid">VISUAL</span> va primero y el <span class="text-acid">AUDIO</span> al final.
    </p>
    {first && <StrudelLab code={labCode} title={`Lab: ${first.data.title}`} />}
  </section>
</BaseLayout>