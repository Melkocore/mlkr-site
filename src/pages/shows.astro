---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
const shows = (await getCollection('shows')).sort((a,b) => a.data.date.valueOf()-b.data.date.valueOf());
const base = import.meta.env.BASE_URL;
---
<BaseLayout title="Shows — M3LK0K093">
  <section class="container py-12">
    <h1 class="font-mono text-acid text-2xl mb-6">## shows</h1>
    {shows.length===0 && <p class="text-fg-muted">Sin fechas por anunciar. Próximamente.</p>}
    <ul class="space-y-3">
      {shows.map(s => (
        <li class="brutal p-4 flex flex-col md:flex-row md:items-center md:justify-between gap-2">
          <div>
            <p class="font-mono text-acid text-sm">{s.data.date.toLocaleDateString('es-ES')}</p>
            <p class="font-bold">{s.data.title}</p>
            <p class="text-fg-muted text-sm">{s.data.venue}, {s.data.city}</p>
          </div>
          <div class="flex items-center gap-3">
            <span class="font-mono text-xs uppercase">{s.data.status}</span>
            {s.data.ticketUrl && <a href={s.data.ticketUrl} target="_blank" rel="noopener" class="brutal px-3 py-1 font-mono text-xs hover:text-acid">tickets →</a>}
          </div>
        </li>
      ))}
    </ul>
  </section>
</BaseLayout>