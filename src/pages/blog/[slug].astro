---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection, render } from 'astro:content';
const base = import.meta.env.BASE_URL;

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map((p) => ({ params: { slug: p.data.slug }, props: { post: p } }));
}

const { post } = Astro.props;
const { Content } = await render(post);
---
<BaseLayout title={`${post.data.title} — M3LK0K093`}>
  <article class="container py-12 max-w-3xl">
    <p class="font-mono text-acid text-sm mb-2"><a href={`${base}blog`}>← blog</a></p>
    <h1 class="text-3xl font-bold">{post.data.title}</h1>
    <p class="text-fg-muted text-sm mt-1">{post.data.date.toLocaleDateString('es-ES')} · {post.data.tags.join(', ')}</p>
    {post.data.cover && <img src={post.data.cover} alt={post.data.title} class="mt-6 w-full border border-grid" loading="lazy" />}
    <div class="mt-6 leading-relaxed space-y-4">
      <Content />
    </div>
  </article>
</BaseLayout>