{
  "name": "mlkr-site",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.23.4"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "design:commands": "figcraft-cli commands --json --filter autoLayout",
    "design:info": "figcraft-cli info design/figcraft/source/m3lk0k093-portal.figcraft",
    "design:render": "figcraft-cli render design/figcraft/source/m3lk0k093-portal.figcraft -o design/exports/portal.png --scale 2",
    "design:export": "figcraft-cli export design/figcraft/source/m3lk0k093-portal.figcraft -o design/exports/ --format svg",
    "design:mcp": "figcraft-cli mcp --automation-read-root design --automation-write-root design/exports"
  },
  "dependencies": {
    "@astrojs/markdown-satteri": "^0.4.6",
    "@astrojs/mdx": "^8.1.2",
    "@astrojs/react": "^7.1.2",
    "@strudel/web": "^1.3.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "astro": "^7.4.4",
    "hydra-synth": "^1.4.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwindcss": "^4.3.3"
  }
}
